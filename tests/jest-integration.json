{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "rootDir": "..",
  "testRegex": ".*\\.integration-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": [
      "babel-jest",
      {
        "configFile": false,
        "babelrc": false,
        "plugins": [
          "@babel/plugin-transform-modules-commonjs",
          "@babel/plugin-transform-export-namespace-from"
        ]
      }
    ]
  },
  "transformIgnorePatterns": [],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^@nestjs/swagger$": "<rootDir>/tests/e2e/swagger.stub.js"
  }
}
